# Web3Forms — legacy (optional fallback)
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Frontend API (Vite proxy uses /api in dev)
VITE_API_URL=/api/v1

# Supabase (public — safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Data backend: supabase | mongodb (auto-detects when service key is set)
# DATA_SOURCE=supabase

# Supabase server-only (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# MongoDB (fallback when Supabase service key is not set)
MONGODB_URI=mongodb://127.0.0.1:27017/novora_cms

# API Server
API_PORT=5000
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Default admin (created/updated by seed script)
ADMIN_EMAIL=admin@novorasolutions.com
ADMIN_PASSWORD=Admin@123456

# Career application email notifications (SMTP)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-app-password
SMTP_FROM=Novora Careers <careers@novorasolutions.com>
CAREERS_REPLY_TO=careers@novorasolutions.com
